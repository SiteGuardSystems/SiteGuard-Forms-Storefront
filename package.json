{
  "name": "siteguard-forms-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SiteGuard FORMS storefront: the multi-page shop at siteguardforms.com.au, built from the Hseq-Dev catalogue, with Stripe one-off checkout and the enquiry API for both SiteGuard sites.",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "build:production": "node scripts/build-site.mjs --production",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sync-legal": "node scripts/sync-legal.mjs",
    "dcr-check": "node scripts/dcr-check.mjs",
    "test": "node scripts/build-site.mjs && node --test lib/*.test.js test/*.test.js",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "engines": {
    "node": ">=20.11 <25"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
