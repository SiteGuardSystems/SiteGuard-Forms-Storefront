# Copy to .env and fill in before going live.

PORT=4300
HOST=0.0.0.0

# The real domain once DNS/hosting are pointed at this app. For local/LAN
# testing on VM2 before that's wired up, use e.g. http://192.168.0.167:4300.
PUBLIC_ORIGIN=https://www.siteguardforms.com.au

# From the Stripe dashboard (Developers -> API keys). Leave unset to run the
# site with checkout disabled — buy buttons fall back to the enquiry form.
STRIPE_SECRET_KEY=
# From Stripe (Developers -> Webhooks) once the webhook endpoint is
# registered against this deployment's public URL.
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com) -- Dashboard -> API Keys. Leave unset to run with email
# disabled: orders still work, confirmation emails are just logged to
# var/mail-events.jsonl instead of sent.
RESEND_API_KEY=
# Until siteguardforms.com.au is verified in Resend (Dashboard -> Domains,
# add the DNS records they give you), use their shared test sender:
#   onboarding@resend.dev
# Swap to something like hello@siteguardforms.com.au once the domain is verified.
RESEND_FROM_EMAIL=

# Where the internal "new order" alert goes -- CRM entry, manual delivery,
# support and quality tracking all start from this email until there's a
# real admin queue. Leave unset to run with no internal alert at all (orders
# still land in var/orders.jsonl either way).
ADMIN_NOTIFICATION_EMAIL=

# SiteGuard-Forms' storefront-orders intake route (server/routes.ts there,
# requireStorefrontApiKey). A paid order is recorded there for manual
# review and delivery -- see docs/ORDER_SITE.md. Leave unset to run with
# orders logged locally only (nothing recorded for review) -- fine for
# UI/checkout testing, not for a real launch. Was the Artifact Factory's
# storefront-orders route until 2026-09-05's consolidation workstream 4.
#   ORDER_INTAKE_URL=http://192.168.0.167:5001/api/v3/storefront-orders
ORDER_INTAKE_URL=
# Must match STOREFRONT_ORDER_INTAKE_API_KEY in SiteGuard-Forms' .env.
ORDER_INTAKE_API_KEY=

# Retrieves and parks a completed order's real files on the library host
# (hseq-dev/docs/park_order.py there) for Dan to review before sending --
# delivery stays manual on purpose (2026-10-04). Leave any of these three
# unset to run with documents not auto-retrieved; orders are still recorded,
# just pulled by hand. The SSH key here must be forced to exactly one remote
# command in that host's authorized_keys -- see docs/ORDER_SITE.md.
PARK_ORDER_HOST=
PARK_ORDER_USER=
PARK_ORDER_SSH_KEY_PATH=
