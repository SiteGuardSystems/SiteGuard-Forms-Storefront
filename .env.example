# Copy to .env and fill in before going live.

PORT=4300
HOST=0.0.0.0

# The real domain once DNS/hosting are pointed at this app. For local/LAN
# testing on VM2 before that's wired up, use e.g. http://192.168.0.167:4300.
PUBLIC_ORIGIN=https://www.siteguardforms.com.au

# From the Stripe dashboard (Developers -> API keys). TEST key (sk_test_) until
# Dan approves go-live. Leave unset to run the site with checkout disabled.
STRIPE_SECRET_KEY=
# From Stripe (Developers -> Webhooks) once the webhook endpoint is
# registered against this deployment's public URL.
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com) -- Dashboard -> API Keys. Leave unset to run with email
# disabled: orders still work, confirmation emails are just logged to
# var/mail-events.jsonl instead of sent.
RESEND_API_KEY=
# Until siteguardforms.com.au is verified in Resend (Dashboard -> Domains,
# add the DNS records they give you), use their shared test sender:
#   onboarding@resend.dev
# Swap to something like hello@siteguardforms.com.au once the domain is verified.
RESEND_FROM_EMAIL=

# Where the internal "new order" alert goes -- CRM entry, manual delivery,
# support and quality tracking all start from this email until there's a
# real admin queue. Leave unset to run with no internal alert at all (orders
# still land in var/orders.jsonl either way).
ADMIN_NOTIFICATION_EMAIL=

# SiteGuard-Forms' storefront-orders intake route (server/routes.ts there,
# requireStorefrontApiKey). A paid order is recorded there for manual
# review and delivery -- see docs/ORDER_SITE.md. Leave unset to run with
# orders logged locally only (nothing recorded for review) -- fine for
# UI/checkout testing, not for a real launch. Was the Artifact Factory's
# storefront-orders route until 2026-09-05's consolidation workstream 4.
#   ORDER_INTAKE_URL=http://192.168.0.167:5001/api/v3/storefront-orders
ORDER_INTAKE_URL=
# Must match STOREFRONT_ORDER_INTAKE_API_KEY in SiteGuard-Forms' .env.
ORDER_INTAKE_API_KEY=
# Go-live 7 Nov 2026: the FORMS switches (sales_open, delivery SLA,
# subscriptions_open, consultant_plans_open) are read with the same key from
# GET /api/v3/storefront/switches on the ORDER_INTAKE_URL host. Set this only
# if they live somewhere else. No URL or key = everything reads as OFF.
FORMS_SWITCHES_URL=

# Retrieves and parks a completed order's real files on the library host
# (hseq-dev/docs/park_order.py there) for Dan to review before sending --
# delivery stays manual on purpose (2026-10-04). Leave any of these three
# unset to run with documents not auto-retrieved; orders are still recorded,
# just pulled by hand. The SSH key here must be forced to exactly one remote
# command in that host's authorized_keys -- see docs/ORDER_SITE.md.
# Optional and superseded by FORMS delivery: park the order's source files on
# the library host for review.
PARK_ORDER_HOST=
PARK_ORDER_USER=
PARK_ORDER_SSH_KEY_PATH=

# Stripe Tax adds GST at checkout (prices are ex GST). Set Stripe Tax up in the
# dashboard first (Settings > Tax: origin address, AU registration). "off"
# disables it.
STRIPE_AUTOMATIC_TAX=on

# Where enquiries from both websites are emailed, and which other origin may
# post them. Falls back to ADMIN_NOTIFICATION_EMAIL only when this line is
# missing: left blank, enquiry emails are off. Set it, or delete the line.
LEAD_NOTIFICATION_EMAIL=
LEAD_ALLOWED_ORIGINS=https://www.siteguardsystems.com.au,https://siteguardsystems.com.au

# Shown to customers in the order email (lib/mailer.js; falls back to
# hello@siteguardsystems.com.au when unset). Dan's decision N1, 8 Nov 2026.
SUPPORT_EMAIL=support@siteguardsystems.com.au

# Behind a reverse proxy (nginx / Caddy / Cloudflare tunnel), the number of
# proxy hops in front of node (usually 1; 2 for Cloudflare proxy + nginx), so
# rate limits see the client's address rather than the proxy's.
TRUST_PROXY=1

# Used at BUILD time (npm run build): where the pages say they live, and the
# FORMS app the Subscribe buttons open.
SITE_ORIGIN=https://www.siteguardforms.com.au
FORMS_APP_URL=https://app.siteguardforms.com.au
SYSTEMS_URL=https://www.siteguardsystems.com.au

# Founding offer admin routes (/api/founding/admin/*: sales export for the P7
# import, refund of the unused prepayment, re-apply go-live). A long random
# string; leave unset to switch those routes off (they answer 404).
FOUNDING_ADMIN_TOKEN=
