[Unit]
Description=SiteGuard FORMS storefront (siteguardforms.com.au -- live production, Stripe LIVE mode, real cards charged)
Documentation=https://siteguardforms.com.au
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/siteguard/forms-storefront
Environment=HOME=/home/ubuntu
Environment=NVM_DIR=/home/ubuntu/.nvm
EnvironmentFile=-/srv/siteguard/forms-storefront/.env

ExecStart=/srv/siteguard/forms-storefront/deploy/run-storefront-prod.sh
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=siteguard-forms-storefront

[Install]
WantedBy=multi-user.target
